{
  "mod_id": "examplemod",
  "base_package": "com.glowingfederal.examplemod",
  "display_name": "ExampleMod",
  "archive_pattern": "{mod_id}-{full_version}+mc{mc}-{loader}.jar",
  "version_class": "{package_path}/BuildVersion.class",
  "required_classes": [
    "{package_path}/ExampleMod.class"
  ],
  "required_shared_classes": [
    "{package_path}/domain/ExampleGreeting.class"
  ],
  "class_roots": [
    "{package_path}/"
  ],
  "resource_roots": [
    "assets/{mod_id}/",
    "data/{mod_id}/"
  ],
  "required_assets": [
    "assets/{mod_id}/textures/{block_textures}/example_block.png",
    "assets/{mod_id}/textures/{item_textures}/example_item.png",
    "assets/{mod_id}/lang/{language_file}"
  ],
  "metadata_profiles": {
    "legacy": {
      "path": "mcmod.info",
      "json_values": {
        "0.modid": "{mod_id}",
        "0.name": "{display_name}",
        "0.version": "{full_version}",
        "0.mcversion": "{mc}"
      }
    },
    "forge": {
      "path": "META-INF/mods.toml",
      "sections": [
        {
          "table": "",
          "fields": {
            "modLoader": "javafml",
            "loaderVersion": "{fml_range}"
          }
        },
        {
          "table": "mods",
          "fields": {
            "modId": "{mod_id}",
            "version": "{full_version}",
            "displayName": "{display_name}"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "{loader}",
            "versionRange": "{loader_range}",
            "mandatory": true
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "minecraft",
            "versionRange": "[{mc}]",
            "mandatory": true
          }
        }
      ]
    },
    "neoforge": {
      "path": "META-INF/neoforge.mods.toml",
      "sections": [
        {
          "table": "",
          "fields": {
            "modLoader": "javafml",
            "loaderVersion": "{fml_range}"
          }
        },
        {
          "table": "mods",
          "fields": {
            "modId": "{mod_id}",
            "version": "{full_version}",
            "displayName": "{display_name}"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "{loader}",
            "versionRange": "{loader_range}",
            "type": "required"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "minecraft",
            "versionRange": "[{mc}]",
            "type": "required"
          }
        }
      ]
    }
  },
